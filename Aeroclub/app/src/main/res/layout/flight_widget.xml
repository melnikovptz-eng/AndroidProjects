<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_card">

    <!-- Header: KD PILOT, flight status, location, live clock and message indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➤  KD PILOT"
            android:textColor="#F7FBFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:background="@drawable/flight_status_pill"
            android:text="●  Сегодня полёты"
            android:textColor="#D9FFF0"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/flight_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:text="⌖  Аэродром «Сокольники»"
            android:textColor="#E3EDF9"
            android:textSize="9sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#F7FBFF"
            android:textSize="10sp"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="✉"
            android:textColor="#F7FBFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:background="#557FA8" />

    <!-- Vario scale and digital time/date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_red" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_red" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_red" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_red" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_neutral" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_neutral" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_neutral" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_neutral" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_neutral" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_neutral" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_green" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_green" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/vario_green" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/vario_green" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="-3" android:textColor="#E6F0FC" android:textSize="10sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="-2" android:textColor="#E6F0FC" android:textSize="10sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="-1" android:textColor="#E6F0FC" android:textSize="10sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="10sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="+1" android:textColor="#E6F0FC" android:textSize="10sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="+2" android:textColor="#E6F0FC" android:textSize="10sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="+3" android:textColor="#E6F0FC" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:background="#6689AE" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.4"
            android:gravity="center"
            android:orientation="vertical">
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="#F5F9FF"
                android:textSize="30sp"
                android:fontFamily="sans"
                android:singleLine="true" />
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, d MMM"
                android:format24Hour="EEE, d MMM"
                android:textColor="#D3E2F4"
                android:textSize="10sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Keep real flight title/status bound for widget updates and accessibility. -->
    <TextView
        android:id="@+id/flight_title"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="Ближайший вылет" />
    <TextView
        android:id="@+id/flight_time"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="Дата и время уточняются" />
    <TextView
        android:id="@+id/flight_status"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="Выберите участника для ответа" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/btn_going"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/btn_going_bg"
            android:text="✓  Еду"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/btn_not_going"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/btn_not_going_bg"
            android:text="✕  Не еду"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/btn_route"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/btn_route_bg"
            android:text="📍 Маршрут"
            android:textColor="#172B4D"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/btn_telegram"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/btn_telegram_bg"
            android:text="➤ Telegram"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>