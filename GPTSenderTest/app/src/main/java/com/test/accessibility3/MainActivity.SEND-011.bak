package com.test.accessibility3;

import android.app.Activity;
import android.os.Bundle;
import android.content.ClipboardManager;
import android.content.ClipData;
import android.content.Context;
import android.content.Intent;
import android.provider.Settings;
import android.graphics.Color;
import android.view.View;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import android.widget.Toast;

public class MainActivity extends Activity {

    private static TextView output;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(16, 16, 16, 16);

        TextView title = new TextView(this);
        title.setText(
                "AccessibilityTester3\n" +
                "СБОРКА: SEND-010\n" +
                "Сканирование выполняет Accessibility Service"
        );
        title.setTextSize(19);
        title.setTextColor(Color.BLACK);
        root.addView(title);

        Button open = new Button(this);
        open.setText("1. ОТКРЫТЬ ACCESSIBILITY");
        open.setOnClickListener(v -> {
            startActivity(
                    new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)
            );
        });
        root.addView(open);

        Button check = new Button(this);
        check.setText("2. ПРОВЕРИТЬ СЕРВИС");
        check.setOnClickListener(v -> {

            if (TesterAccessibilityServiceHolder.service != null) {
                show("СЕРВИС РАБОТАЕТ\n\n" +
                     "Теперь открой ChatGPT.\n" +
                     "Service будет автоматически сохранять дерево.");
            } else {
                show("СЕРВИС НЕ ПОДКЛЮЧЁН");
            }
        });
        root.addView(check);

        Button read = new Button(this);
        read.setText("3. ПОКАЗАТЬ СКАН CHATGPT");
        read.setOnClickListener(v -> showLastScan());
        root.addView(read);

        Button copy = new Button(this);
        copy.setText("КОПИРОВАТЬ ВЫВОД");
        copy.setOnClickListener(v -> copyOutput());
        root.addView(copy);

        Button clear = new Button(this);
        clear.setText("ОЧИСТИТЬ ВЫВОД");
        clear.setOnClickListener(v -> output.setText(""));
        root.addView(clear);

        ScrollView scroll = new ScrollView(this);

        output = new TextView(this);
        output.setTextSize(12);
        output.setTextColor(Color.BLACK);
        output.setTextIsSelectable(true);
        output.setPadding(10, 10, 10, 10);

        scroll.addView(output);

        root.addView(
                scroll,
                new LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.MATCH_PARENT,
                        0,
                        1
                )
        );

        setContentView(root);

        show(
                "SEND-010 ГОТОВ\n\n" +
                "1. Включи Accessibility.\n" +
                "2. Открой ChatGPT.\n" +
                "3. Подожди 1–2 секунды.\n" +
                "4. Вернись сюда.\n" +
                "5. Нажми «ПОКАЗАТЬ СКАН CHATGPT»."
        );
    }

    public static void refresh() {
        // Ничего не стираем.
    }

    private static void show(String text) {
        if (output != null) {
            output.setText(text);
        }
    }

    private void showLastScan() {

        if (TesterAccessibilityServiceHolder.service == null) {
            show("СЕРВИС НЕ ПОДКЛЮЧЁН");
            return;
        }

        String result =
                TesterAccessibilityService.readResult(
                        TesterAccessibilityServiceHolder.service
                );

        output.setText(result);
    }

    private void copyOutput() {

        if (output == null) return;

        String text = output.getText().toString();

        if (text.trim().isEmpty()) {
            Toast.makeText(
                    this,
                    "Вывод пуст",
                    Toast.LENGTH_SHORT
            ).show();
            return;
        }

        ClipboardManager clipboard =
                (ClipboardManager)
                        getSystemService(Context.CLIPBOARD_SERVICE);

        clipboard.setPrimaryClip(
                ClipData.newPlainText(
                        "SEND-010",
                        text
                )
        );

        Toast.makeText(
                this,
                "СКОПИРОВАНО",
                Toast.LENGTH_SHORT
        ).show();
    }
}
