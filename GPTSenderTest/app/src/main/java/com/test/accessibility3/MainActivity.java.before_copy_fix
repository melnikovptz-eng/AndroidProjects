package com.test.accessibility3;

import android.app.Activity;
import android.os.Bundle;
import android.os.Handler;
import android.content.Intent;
import android.provider.Settings;
import android.graphics.Color;
import android.view.Gravity;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import android.widget.EditText;
import com.test.accessibility3.modules.response.TaperResponseChecker;

public class MainActivity extends Activity {

    private final TaperResponseChecker taperChecker =
            new TaperResponseChecker();

    private EditText output;

    private final Handler handler =
            new Handler();

    @Override
    protected void onCreate(
            Bundle savedInstanceState) {

        super.onCreate(
                savedInstanceState
        );

        LinearLayout root =
                new LinearLayout(this);

        root.setOrientation(
                LinearLayout.VERTICAL
        );

        root.setPadding(
                20,
                20,
                20,
                20
        );

        TextView title =
                new TextView(this);

        title.setText(
                "AccessibilityTester3\nMODULAR"
        );

        title.setTextSize(22);

        title.setGravity(
                Gravity.CENTER
        );

        title.setPadding(
                0,
                0,
                0,
                20
        );

        root.addView(title);

        Button accessibility =
                new Button(this);

        accessibility.setText(
                "1. ОТКРЫТЬ ACCESSIBILITY"
        );

        accessibility.setOnClickListener(
                v -> {

                    try {

                        startActivity(
                                new Intent(
                                        Settings
                                            .ACTION_ACCESSIBILITY_SETTINGS
                                )
                        );

                    } catch (Exception ignored) {
                    }
                }
        );

        root.addView(accessibility);

        Button check =
                new Button(this);

        check.setText(
                "2. ПРОВЕРИТЬ СЕРВИС"
        );

        check.setOnClickListener(
                v -> {

                    if (TesterAccessibilityServiceHolder
                            .service != null) {

                        output.setText(
                                "СЕРВИС ACCESSIBILITY: OK\n"
                        );

                    } else {

                        output.setText(
                                "СЕРВИС НЕ ПОДКЛЮЧЕН\n"
                        );
                    }
                }
        );

        root.addView(check);

        Button scan =
                new Button(this);

        scan.setText(
                "3. ПОКАЗАТЬ СКАН CHATGPT"
        );

        scan.setOnClickListener(
                v -> refresh()
        );

        root.addView(scan);

        Button send =
                new Button(this);

        send.setText(
                "ОТПРАВИТЬ В CHATGPT"
        );

        send.setTextSize(18);

        send.setOnClickListener(
                v -> {
                    output.append(
                            "\n\n=== CHATGPT SEND START ===\n"
                    );

                    boolean inserted =
                            TesterAccessibilityService
                                    .prepareChatGPTCommand();

                    if (!inserted) {
                        output.append(
                                "INPUT INSERT: FAILED\n"
                        );
                        return;
                    }

                    output.append(
                            "INPUT INSERT: OK\n"
                    );

                    handler.postDelayed(
                            () -> {
                                boolean sent =
                                        TesterAccessibilityService
                                                .clickSend();

                                if (sent) {
                                    output.append(
                                            "SEND BUTTON: CLICKED\n"
                                    );
                                } else {
                                    output.append(
                                            "SEND BUTTON: NOT FOUND/FAILED\n"
                                    );
                                }

                                refresh();
                            },
                            700
                    );
                }
        );


        root.addView(send);

        Button copy =
                new Button(this);

        copy.setText(
                "КОПИРОВАТЬ ВЫВОД"
        );

        copy.setOnClickListener(
                v -> {

                    String text =
                            output.getText().toString();

                    TaperResponseChecker.Result result =
                            taperChecker.check(text);

                    if (result ==
                            TaperResponseChecker.Result.LOADING) {

                        output.append(
                                "\n\n⚠️ КОМАНДА ЕЩЁ НЕ ПРОГРУЗИЛАСЬ\n"
                        );

                        return;
                    }

                    if (result ==
                            TaperResponseChecker.Result.NOT_FOUND) {

                        output.append(
                                "\n\n⚠️ МЕТКА TAPER НЕ НАЙДЕНА\n"
                        );

                        return;
                    }

                    android.content.ClipboardManager cb =
                            (android.content.ClipboardManager)
                                    getSystemService(
                                            CLIPBOARD_SERVICE
                                    );

                    cb.setPrimaryClip(
                            android.content.ClipData
                                    .newPlainText(
                                            "MODULAR",
                                            text
                                    )
                    );

                    output.append(
                            "\n\n✅ КОПИРОВАНИЕ РАЗРЕШЕНО\n"
                    );
                }
        );

        root.addView(copy);

        Button clear =
                new Button(this);

        clear.setText(
                "ОЧИСТИТЬ ВЫВОД"
        );

        clear.setOnClickListener(
                v -> output.setText("")
        );

        root.addView(clear);

        ScrollView scroll =
                new ScrollView(this);

        output =
                new EditText(this);

        output.setTextSize(12);

        output.setTextColor(
                Color.WHITE
        );

        output.setBackgroundColor(
                Color.BLACK
        );

        output.setPadding(
                12,
                12,
                12,
                12
        );

        scroll.addView(output);

        LinearLayout.LayoutParams
                scrollParams =
                new LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams
                                .MATCH_PARENT,
                        0,
                        1
                );

        scrollParams.topMargin = 15;

        root.addView(
                scroll,
                scrollParams
        );

        setContentView(root);
    }

    private void refresh() {

        if (TesterAccessibilityServiceHolder
                .service == null) {

            output.setText(
                    "СЕРВИС НЕ ПОДКЛЮЧЕН\n"
            );

            return;
        }

        output.setText(
                TesterAccessibilityService
                        .readResult(
                                TesterAccessibilityServiceHolder
                                        .service
                        )
        );
    }

    @Override
    protected void onResume() {

        super.onResume();

        handler.postDelayed(
                () -> refresh(),
                300
        );
    }
}
