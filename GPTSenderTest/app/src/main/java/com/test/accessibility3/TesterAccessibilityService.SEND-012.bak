package com.test.accessibility3;

import android.accessibilityservice.AccessibilityService;
import android.graphics.Rect;
import android.os.Bundle;
import android.os.Handler;
import android.view.accessibility.AccessibilityEvent;
import android.view.accessibility.AccessibilityNodeInfo;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.util.ArrayList;

public class TesterAccessibilityService extends AccessibilityService {

    private final Handler handler = new Handler();

    private boolean testStarted = false;
    private boolean textInserted = false;

    @Override
    public void onServiceConnected() {
        super.onServiceConnected();
        TesterAccessibilityServiceHolder.service = this;
    }

    @Override
    public void onAccessibilityEvent(AccessibilityEvent event) {

        if (event == null || event.getPackageName() == null)
            return;

        String pkg = event.getPackageName().toString();

        if (!pkg.equals("com.openai.chatgpt"))
            return;

        /*
         * ВАЖНО:
         * SEND-012 запускает тест только один раз.
         * После SET_TEXT новые accessibility-события
         * больше не запускают вставку заново.
         */

        if (testStarted)
            return;

        testStarted = true;

        handler.removeCallbacksAndMessages(null);

        handler.postDelayed(() -> runSend012(), 500);
    }

    private void runSend012() {

        AccessibilityNodeInfo root = getRootInActiveWindow();

        if (root == null) {
            save("=== SEND-012 ===\nROOT: NULL\n");
            return;
        }

        AccessibilityNodeInfo edit = findEditText(root);

        StringBuilder out = new StringBuilder();

        out.append("=== SEND-012 ===\n");
        out.append("PACKAGE: com.openai.chatgpt\n\n");

        if (edit == null) {
            out.append("EDITTEXT: НЕ НАЙДЕН\n");
            save(out.toString());
            return;
        }

        out.append("EDITTEXT НАЙДЕН\n");

        dumpNode(edit, out, "EDITTEXT");

        Bundle b = new Bundle();

        b.putCharSequence(
                AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE,
                "SEND-012 TEST"
        );

        boolean set = edit.performAction(
                AccessibilityNodeInfo.ACTION_SET_TEXT,
                b
        );

        textInserted = set;

        out.append("\nSET_TEXT: ")
                .append(set)
                .append("\n");

        /*
         * Ждём пока Compose обновит интерфейс.
         * После появления текста кнопка Send должна
         * измениться в дереве Accessibility.
         */

        handler.postDelayed(() -> scanSendButton(out), 900);
    }

    private void scanSendButton(StringBuilder out) {

        AccessibilityNodeInfo root = getRootInActiveWindow();

        if (root == null) {
            out.append("\nROOT AFTER TEXT: NULL\n");
            save(out.toString());
            return;
        }

        AccessibilityNodeInfo edit = findEditText(root);

        if (edit == null) {
            out.append("\nEDITTEXT AFTER TEXT: НЕ НАЙДЕН\n");
            save(out.toString());
            return;
        }

        Rect editRect = new Rect();
        edit.getBoundsInScreen(editRect);

        out.append("\n=== ПОИСК КНОПКИ SEND ===\n");
        out.append("EDIT BOUNDS: ")
                .append(rectString(editRect))
                .append("\n");

        ArrayList<AccessibilityNodeInfo> clickable =
                new ArrayList<>();

        collectClickable(root, clickable);

        AccessibilityNodeInfo best = null;
        Rect bestRect = null;
        int bestScore = Integer.MIN_VALUE;

        int index = 0;

        for (AccessibilityNodeInfo n : clickable) {

            index++;

            if (n == null || !n.isEnabled())
                continue;

            Rect r = new Rect();
            n.getBoundsInScreen(r);

            if (r.width() <= 0 || r.height() <= 0)
                continue;

            int cy = (r.top + r.bottom) / 2;
            int ey = (editRect.top + editRect.bottom) / 2;

            int verticalDistance = Math.abs(cy - ey);

            /*
             * Кнопка Send обычно находится на одной линии
             * с полем ввода.
             */
            if (verticalDistance > editRect.height() * 2)
                continue;

            int score = 0;

            /*
             * Та же горизонтальная полоса.
             */
            score += 1000 - verticalDistance;

            /*
             * Чем правее кнопка, тем вероятнее это Send.
             */
            score += r.right / 10;

            /*
             * Элемент после поля ввода в дереве обычно
             * находится ближе к кнопкам панели.
             */
            if (r.left >= editRect.left)
                score += 100;

            String desc = String.valueOf(
                    n.getContentDescription()
            ).toLowerCase();

            String text = String.valueOf(
                    n.getText()
            ).toLowerCase();

            if (desc.contains("отправ"))
                score += 5000;

            if (desc.contains("send"))
                score += 5000;

            if (text.contains("отправ"))
                score += 5000;

            if (text.contains("send"))
                score += 5000;

            out.append("\nCANDIDATE #")
                    .append(index)
                    .append("\n");

            dumpNode(n, out, "CANDIDATE");

            if (score > bestScore) {
                bestScore = score;
                best = n;
                bestRect = new Rect(r);
            }
        }

        out.append("\n=== ВЫБРАННАЯ КНОПКА ===\n");

        if (best == null) {

            out.append("SEND: НЕ НАЙДЕН\n");

        } else {

            out.append("SEND: КАНДИДАТ НАЙДЕН\n");
            out.append("SCORE: ")
                    .append(bestScore)
                    .append("\n");

            dumpNode(best, out, "SEND CANDIDATE");

            out.append("\nВАЖНО: автоматического нажатия НЕТ.\n");
            out.append("Нажми кнопку «ОТПРАВИТЬ В CHATGPT» в приложении.\n");
        }

        save(out.toString());
    }

    /*
     * Вызывается нашей кнопкой из MainActivity.
     */
    public static boolean clickSend() {

        AccessibilityService service =
                TesterAccessibilityServiceHolder.service;

        if (service == null)
            return false;

        AccessibilityNodeInfo root =
                service.getRootInActiveWindow();

        if (root == null)
            return false;

        AccessibilityNodeInfo edit =
                findEditTextStatic(root);

        if (edit == null)
            return false;

        Rect editRect = new Rect();
        edit.getBoundsInScreen(editRect);

        ArrayList<AccessibilityNodeInfo> nodes =
                new ArrayList<>();

        collectClickableStatic(root, nodes);

        AccessibilityNodeInfo best = null;
        int bestScore = Integer.MIN_VALUE;

        for (AccessibilityNodeInfo n : nodes) {

            if (n == null || !n.isEnabled())
                continue;

            Rect r = new Rect();
            n.getBoundsInScreen(r);

            if (r.width() <= 0 || r.height() <= 0)
                continue;

            int cy = (r.top + r.bottom) / 2;
            int ey = (editRect.top + editRect.bottom) / 2;

            int verticalDistance =
                    Math.abs(cy - ey);

            if (verticalDistance >
                    editRect.height() * 2)
                continue;

            int score =
                    1000 - verticalDistance;

            /*
             * Send обычно справа от поля.
             */
            score += r.right / 10;

            String desc =
                    String.valueOf(
                            n.getContentDescription()
                    ).toLowerCase();

            String text =
                    String.valueOf(
                            n.getText()
                    ).toLowerCase();

            if (desc.contains("отправ"))
                score += 5000;

            if (desc.contains("send"))
                score += 5000;

            if (text.contains("отправ"))
                score += 5000;

            if (text.contains("send"))
                score += 5000;

            if (score > bestScore) {
                bestScore = score;
                best = n;
            }
        }

        if (best == null)
            return false;

        return best.performAction(
                AccessibilityNodeInfo.ACTION_CLICK
        );
    }

    private AccessibilityNodeInfo findEditText(
            AccessibilityNodeInfo node) {

        if (node == null)
            return null;

        if ("android.widget.EditText".contentEquals(
                node.getClassName())
                && node.isEditable()) {

            return node;
        }

        for (int i = 0;
             i < node.getChildCount();
             i++) {

            AccessibilityNodeInfo child =
                    node.getChild(i);

            AccessibilityNodeInfo found =
                    findEditText(child);

            if (found != null)
                return found;
        }

        return null;
    }

    private static AccessibilityNodeInfo findEditTextStatic(
            AccessibilityNodeInfo node) {

        if (node == null)
            return null;

        if ("android.widget.EditText".contentEquals(
                node.getClassName())
                && node.isEditable()) {

            return node;
        }

        for (int i = 0;
             i < node.getChildCount();
             i++) {

            AccessibilityNodeInfo found =
                    findEditTextStatic(node.getChild(i));

            if (found != null)
                return found;
        }

        return null;
    }

    private void collectClickable(
            AccessibilityNodeInfo node,
            ArrayList<AccessibilityNodeInfo> list) {

        if (node == null)
            return;

        if (node.isClickable() && node.isEnabled())
            list.add(node);

        for (int i = 0;
             i < node.getChildCount();
             i++) {

            collectClickable(
                    node.getChild(i),
                    list
            );
        }
    }

    private static void collectClickableStatic(
            AccessibilityNodeInfo node,
            ArrayList<AccessibilityNodeInfo> list) {

        if (node == null)
            return;

        if (node.isClickable() && node.isEnabled())
            list.add(node);

        for (int i = 0;
             i < node.getChildCount();
             i++) {

            collectClickableStatic(
                    node.getChild(i),
                    list
            );
        }
    }

    private void dumpNode(
            AccessibilityNodeInfo n,
            StringBuilder out,
            String name) {

        if (n == null)
            return;

        Rect r = new Rect();
        n.getBoundsInScreen(r);

        out.append(name).append("\n");
        out.append("CLASS: ")
                .append(n.getClassName())
                .append("\n");

        out.append("TEXT: ")
                .append(n.getText())
                .append("\n");

        out.append("DESC: ")
                .append(n.getContentDescription())
                .append("\n");

        out.append("CLICKABLE: ")
                .append(n.isClickable())
                .append("\n");

        out.append("FOCUSABLE: ")
                .append(n.isFocusable())
                .append("\n");

        out.append("FOCUSED: ")
                .append(n.isFocused())
                .append("\n");

        out.append("ENABLED: ")
                .append(n.isEnabled())
                .append("\n");

        out.append("EDITABLE: ")
                .append(n.isEditable())
                .append("\n");

        out.append("BOUNDS: ")
                .append(rectString(r))
                .append("\n");
    }

    private String rectString(Rect r) {
        return r.left + "," +
                r.top + " - " +
                r.right + "," +
                r.bottom;
    }

    public static String readResult(
            AccessibilityService service) {

        try {

            File f = new File(
                    service.getFilesDir(),
                    "last_scan.txt"
            );

            if (!f.exists())
                return "Файл last_scan.txt не найден";

            FileInputStream fis =
                    new FileInputStream(f);

            byte[] data =
                    new byte[(int) f.length()];

            int n = fis.read(data);

            fis.close();

            return new String(
                    data,
                    0,
                    n,
                    "UTF-8"
            );

        } catch (Exception e) {

            return "Ошибка чтения: " +
                    e.getMessage();
        }
    }

    private void save(String text) {

        try {

            File f = new File(
                    getFilesDir(),
                    "last_scan.txt"
            );

            FileOutputStream fos =
                    new FileOutputStream(f, false);

            fos.write(
                    text.getBytes("UTF-8")
            );

            fos.close();

        } catch (Exception ignored) {
        }
    }

    @Override
    public void onInterrupt() {
    }
}
