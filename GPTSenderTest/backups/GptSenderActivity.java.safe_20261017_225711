package com.test.accessibility3;

import android.app.Activity;
import android.os.Bundle;
import android.content.Intent;
import android.provider.Settings;
import android.view.Gravity;
import android.view.View;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import android.graphics.Color;
import android.text.InputType;
import android.widget.EditText;

public class GptSenderActivity extends Activity {
    private TextView status;
    private EditText message;

    private void log(String event, String details) {
        GptSenderLog.write(this, event, details);
    }

    private void refreshLog() {
        status.setText(GptSenderLog.read(this));
    }

    private Button button(LinearLayout parent, String label,
                          View.OnClickListener listener) {
        Button b = new Button(this);
        b.setText(label);
        b.setTextSize(16);
        b.setAllCaps(false);
        b.setMinHeight(54);
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(
            -1, -2
        );
        p.setMargins(8, 6, 8, 6);
        parent.addView(b, p);
        b.setOnClickListener(listener);
        return b;
    }

    @Override
    protected void onCreate(Bundle saved) {
        super.onCreate(saved);

        log("APP_OPEN", "GPTSenderTest started");

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(12, 12, 12, 12);
        root.setBackgroundColor(Color.WHITE);

        TextView title = new TextView(this);
        title.setText("GPTSenderTest — PMCA 0.2.0 / Build 3");
        title.setTextColor(Color.BLACK);
        title.setTextSize(20);
        root.addView(title);

        TextView hint = new TextView(this);
        hint.setText(
            "Отправка выполняется только после нажатия кнопки. " +
            "Успешный клик не считается подтверждением отправки."
        );
        hint.setTextColor(Color.DKGRAY);
        hint.setTextSize(14);
        root.addView(hint);

        message = new EditText(this);
        message.setText("Тест GPTSenderTest");
        message.setHint("Текст тестового сообщения");
        message.setMinLines(2);
        message.setMaxLines(4);
        message.setInputType(
            InputType.TYPE_CLASS_TEXT |
            InputType.TYPE_TEXT_FLAG_MULTI_LINE
        );
        root.addView(message, new LinearLayout.LayoutParams(-1, -2));

        button(root, "1. Открыть настройки Accessibility", v -> {
            log("ACCESSIBILITY_SETTINGS_OPEN", "User requested settings");
            startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS));
        });

        button(root, "2. Подготовить тест в ChatGPT", v -> {
            String text = message.getText().toString();

            if (text.trim().isEmpty()) {
                log("PREPARE_FAILED", "Empty test message");
                refreshLog();
                return;
            }

            log("OPERATION_START", "Preparing test message");

            boolean ok = TesterAccessibilityService
                .prepareChatGPTCommand(text);

            log(ok ? "INPUT_PREPARE_RESULT" : "INPUT_PREPARE_FAILED",
                "prepareChatGPTCommand returned " + ok);

            refreshLog();
        });

        button(root, "3. Отправить подготовленное сообщение", v -> {
            log("SEND_OPERATION_START", "Manual send button pressed");

            boolean clicked = TesterAccessibilityService.clickSend();

            log("CLICK_RESULT", "clickSend returned " + clicked);

            log("SEND_CONFIRMATION_PENDING",
                "Click result is not proof of message delivery");

            refreshLog();
        });

        button(root, "Обновить журнал", v -> refreshLog());

        status = new TextView(this);
        status.setTextColor(Color.BLACK);
        status.setTextSize(12);
        status.setTextIsSelectable(true);

        ScrollView scroll = new ScrollView(this);
        scroll.addView(status);
        root.addView(scroll, new LinearLayout.LayoutParams(
            -1, 0, 1
        ));

        setContentView(root);
        refreshLog();
    }

    @Override
    protected void onResume() {
        super.onResume();
        if (status != null) refreshLog();
    }
}
